# Copie este arquivo para ".env" (na raiz do projeto, ao lado do
# docker-compose.yml) e preencha com valores reais. O ".env" nunca deve
# ser commitado (já está no .gitignore).
#
# O Docker Compose carrega ".env" automaticamente e substitui ${DB_USER},
# ${DB_PASSWORD}, ${DB_NAME} no docker-compose.yml. O container ufpa_rag_ui
# recebe as mesmas variáveis, usadas por app/scripts/ingestao.py.

DB_NAME=ufpa_rag
DB_USER=admin
DB_PASSWORD=troque-esta-senha
