@dataclass(frozen=True)
class Passage:
    score: float
    text: str
    url: str
    title: str


def _normalize(text: str) -> str:
    text = unicodedata.normalize(
        "NFKD",
        text or "",
    )

    text = "".join(
        char
        for char in text
        if not unicodedata.combining(char)
    )

    text = text.lower()

    text = re.sub(
        r"[^a-z0-9\s\-_/]",
        " ",
        text,
    )

    return re.sub(
        r"\s+",
        " ",
        text,
    ).strip()


def _tokens(text: str) -> List[str]:
    return [
        token
        for token in re.findall(
            r"[a-z0-9]{2,}",
            _normalize(text),
        )
        if token not in STOPWORDS
    ]


def _contains_phrase(
    normalized_text: str,
    phrase: str,
) -> bool:
    phrase = _normalize(phrase)

    pattern = (
        r"(?<![a-z0-9])"
        + re.escape(phrase)
        + r"(?![a-z0-9])"
    )

    return bool(
        re.search(
            pattern,
            normalized_text,
        )
    )


def _is_official_fct_url(url: str) -> bool:
    try:
        host = (
            urlparse(url).hostname or ""
        ).lower()

        return (
            host == FCT_DOMAIN
            or host.endswith(
                "." + FCT_DOMAIN
            )
        )

    except Exception:
        return False


def is_simple_fct_question(
    question: str,
) -> bool:
    if not isinstance(
        question,
        str,
    ):
        return False

    q = _normalize(question)

    if not q:
        return False

    q_tokens = set(
        _tokens(q)
    )

    # RU como palavra isolada.
    if "ru" in q_tokens:
        return False

    # PROAES/cardápio continuam na rota atual.
    if any(
        _contains_phrase(q, phrase)
        for phrase in SPECIAL_PHRASES
    ):
        return False

    # Questões complexas continuam no RAG.
    if any(
        _contains_phrase(q, phrase)
        for phrase in COMPLEX_PHRASES
    ):
        return False

    words = q.split()

    if len(words) > 28:
        return False

    if any(
        _contains_phrase(q, phrase)
        for phrase in SIMPLE_PHRASES
    ):
        return True

    institutional_markers = {
        "ufpa",
        "fct",
        "faculdade",
        "computacao",
        "telecomunicacoes",
        "curso",
        "secretaria",
        "professor",
        "docente",
        "coordenacao",
    }

    if (
        len(words) <= 14
        and bool(
            q_tokens
            & institutional_markers
        )
    ):
        return True

    return False


class _FCTHTMLParser(HTMLParser):
    BLOCK_TAGS = {
        "h1",
        "h2",
        "h3",
        "h4",
        "p",
        "li",
        "td",
        "th",
    }

    SKIP_TAGS = {
        "script",
        "style",
        "noscript",
        "svg",
        "iframe",
        "form",
    }

    def __init__(self) -> None:
        super().__init__(
            convert_charrefs=True
        )

        self.skip_depth = 0

        self.current_block_tag: Optional[str] = None
        self.current_block_parts: List[str] = []

        self.current_anchor_href: Optional[str] = None
        self.current_anchor_parts: List[str] = []

        self.passages: List[str] = []
        self.links: List[Tuple[str, str]] = []

        self.title_parts: List[str] = []
        self.in_title = False


    def handle_starttag(
        self,
        tag: str,
        attrs,
    ) -> None:
        tag = tag.lower()

        if tag in self.SKIP_TAGS:
            self.skip_depth += 1
            return

        if self.skip_depth:
            return

        attrs_dict = dict(attrs)

        if tag == "title":
            self.in_title = True

        if tag in self.BLOCK_TAGS:
            if self.current_block_tag is not None:
                self._flush_block()

            self.current_block_tag = tag
            self.current_block_parts = []

        if tag == "a":
            self.current_anchor_href = (
                attrs_dict.get("href")
            )
            self.current_anchor_parts = []


    def handle_endtag(
        self,
        tag: str,
    ) -> None:
        tag = tag.lower()

        if tag in self.SKIP_TAGS:
            if self.skip_depth:
                self.skip_depth -= 1
            return

        if self.skip_depth:
            return

        if tag == "title":
            self.in_title = False

        if (
            self.current_block_tag is not None
            and tag == self.current_block_tag
        ):
            self._flush_block()

        if tag == "a":
            self._flush_anchor()


    def handle_data(
        self,
        data: str,
    ) -> None:
        if self.skip_depth:
            return

        text = re.sub(
            r"\s+",
            " ",
            data,
        ).strip()

        if not text:
            return

        if self.in_title:
            self.title_parts.append(text)

        if self.current_block_tag is not None:
            self.current_block_parts.append(text)

        if self.current_anchor_href is not None:
            self.current_anchor_parts.append(text)


    def close(self) -> None:
        self._flush_block()
        self._flush_anchor()
        super().close()


    def _flush_block(self) -> None:
        if self.current_block_tag is None:
            return

        text = re.sub(
            r"\s+",
            " ",
            " ".join(
                self.current_block_parts
            ),
        ).strip()

        if text:
            self.passages.append(text)

        self.current_block_tag = None
        self.current_block_parts = []


    def _flush_anchor(self) -> None:
        if self.current_anchor_href is None:
            return

        anchor_text = re.sub(
            r"\s+",
            " ",
            " ".join(
                self.current_anchor_parts
            ),
        ).strip()

        self.links.append(
            (
                self.current_anchor_href,
                anchor_text,
            )
        )

        self.current_anchor_href = None
        self.current_anchor_parts = []


    @property
    def title(self) -> str:
        return re.sub(
            r"\s+",
            " ",
            " ".join(self.title_parts),
        ).strip()


def _parse_html(
    html: str,
) -> _FCTHTMLParser:
    parser = _FCTHTMLParser()

    try:
        parser.feed(html)
        parser.close()
    except Exception:
        # HTML imperfeito não deve derrubar a Minerva.
        pass

    return parser


def _cache_get(
    key: str,
) -> Optional[str]:
    item = _CACHE.get(key)

    if item is None:
        return None

    created_at, value = item

    if (
        time.time() - created_at
        > CACHE_TTL_SECONDS
    ):
        _CACHE.pop(
            key,
            None,
        )
        return None

    return value


def _cache_set(
    key: str,
    value: str,
) -> None:
    _CACHE[key] = (
        time.time(),
        value,
    )


def _fetch(
    url: str,
) -> Optional[str]:
    if not _is_official_fct_url(url):
        return None

    request = Request(
        url,
        headers={
            "User-Agent": (
                "MinervaAI-UFPA/1.0 "
                "(assistente academico institucional)"
            ),
            "Accept": (
                "text/html,"
                "application/xhtml+xml"
            ),
            "Accept-Language": (
                "pt-BR,pt;q=0.9"
            ),
        },
        method="GET",
    )

    try:
        with urlopen(
            request,
            timeout=REQUEST_TIMEOUT,
        ) as response:

            final_url = response.geturl()

            if not _is_official_fct_url(
                final_url
            ):
                return None

            content_type = (
                response.headers.get(
                    "Content-Type",
                    "",
                )
                or ""
            ).lower()

            if (
                content_type
                and "text/html" not in content_type
                and "application/xhtml+xml"
                not in content_type
            ):
                return None

            raw = response.read()

            charset = (
                response.headers.get_content_charset()
                or "utf-8"
            )

            try:
                return raw.decode(
                    charset,
                    errors="replace",
                )
            except LookupError:
                return raw.decode(
                    "utf-8",
                    errors="replace",
                )

    except (
        HTTPError,
        URLError,
        TimeoutError,
        OSError,
    ):
        return None


def _discover_links(
    html: str,
    source_url: str,
    question_tokens: Sequence[str],
) -> List[Tuple[float, str]]:
    parser = _parse_html(html)

    qset = set(question_tokens)

    found: Dict[str, float] = {}

    useful_terms = (
        "graduacao",
        "computacao",
        "telecomunicacoes",
        "docente",
        "documentacao",
        "disciplina",
        "estagio",
        "laboratorio",
        "secretaria",
        "historico",
        "faculdade",
        "noticia",
        "concurso",
        "intercambio",
        "coordenacao",
    )

    for href, anchor_text in parser.links:
        if not href:
            continue

        absolute = urljoin(
            source_url,
            href,
        )

        absolute = absolute.split(
            "#",
            1,
        )[0]

        if not _is_official_fct_url(
            absolute
        ):
            continue

        material = _normalize(
            anchor_text
            + " "
            + absolute
        )

        link_tokens = set(
            _tokens(material)
        )

        overlap = len(
            qset & link_tokens
        )

        score = overlap * 6.0

        if "/index.php/" in absolute:
            score += 1.0

        if any(
            term in material
            for term in useful_terms
        ):
            score += 2.0

        current = found.get(
            absolute
        )

        if (
            current is None
            or score > current
        ):
            found[absolute] = score

    return sorted(
        (
            (score, url)
            for url, score in found.items()
        ),
        key=lambda item: item[0],
        reverse=True,
    )


def _extract_passages(
    html: str,
    url: str,
    question_tokens: Sequence[str],
) -> List[Passage]:
    parser = _parse_html(html)

    title = (
        parser.title[:250]
        if parser.title
        else "FCT/UFPA"
    )

    qset = set(question_tokens)

    passages: List[Passage] = []

    for text in parser.passages:
        text = re.sub(
            r"\s+",
            " ",
            text,
        ).strip()

        if not (
            30 <= len(text) <= 1800
        ):
            continue

        text_tokens = set(
            _tokens(text)
        )

        overlap = len(
            qset & text_tokens
        )

        coverage = (
            overlap
            / max(
                1,
                len(qset),
            )
            if qset
            else 0.0
        )

        score = (
            overlap * 5.0
            + coverage * 10.0
        )

        normalized_text = _normalize(
            text
        )

        for token in qset:
            if token in normalized_text:
                score += 0.8

        if score > 0:
            passages.append(
                Passage(
                    score=score,
                    text=text,
                    url=url,
                    title=title,
                )
            )

    return passages


def search_fct_context(
    question: str,
) -> str:
    if not isinstance(
        question,
        str,
    ):
        return ""

    cache_key = hashlib.sha256(
        _normalize(question).encode(
            "utf-8"
        )
    ).hexdigest()

    cached = _cache_get(
        cache_key
    )

    if cached is not None:
        return cached

    question_tokens = _tokens(
        question
    )

    search_url = (
        FCT_BASE_URL
        + "index.php/component/search/"
        + "?searchword="
        + quote_plus(question)
        + "&searchphrase=all"
    )

    seed_urls = [
        search_url,
        FCT_BASE_URL,
    ]

    html_by_url: Dict[str, str] = {}
    discovered: Dict[str, float] = {}

    for seed_url in seed_urls:
        html = _fetch(
            seed_url
        )

        if not html:
            continue

        html_by_url[
            seed_url
        ] = html

        for score, link in _discover_links(
            html,
            seed_url,
            question_tokens,
        ):
            current = discovered.get(
                link
            )

            if (
                current is None
                or score > current
            ):
                discovered[link] = score

    ranked_links = sorted(
        discovered.items(),
        key=lambda item: item[1],
        reverse=True,
    )[:MAX_LINKS_TO_FETCH]

    for url, _score in ranked_links:
        if url in html_by_url:
            continue

        html = _fetch(url)

        if html:
            html_by_url[url] = html

    all_passages: List[Passage] = []

    for url, html in html_by_url.items():
        all_passages.extend(
            _extract_passages(
                html,
                url,
                question_tokens,
            )
        )

    unique: Dict[str, Passage] = {}

    for passage in all_passages:
        fingerprint = _normalize(
            passage.text
        )[:700]

        current = unique.get(
            fingerprint
        )

        if (
            current is None
            or passage.score
            > current.score
        ):
            unique[
                fingerprint
            ] = passage

    ranked = sorted(
        unique.values(),
        key=lambda passage: passage.score,
        reverse=True,
    )[:MAX_PASSAGES]

    if not ranked:
        _cache_set(
            cache_key,
            "",
        )
        return ""

    blocks: List[str] = []
    total_chars = 0

    for index, passage in enumerate(
        ranked,
        start=1,
    ):
        block = (
            f"[EVIDENCIA FCT {index}]\n"
            f"Titulo: {passage.title}\n"
            f"Trecho: {passage.text}\n"
            f"Fonte: {passage.url}\n"
        )

        if (
            total_chars + len(block)
            > MAX_CONTEXT_CHARS
        ):
            break

        blocks.append(block)
        total_chars += len(block)

    result = "\n".join(
        blocks
    ).strip()

    _cache_set(
        cache_key,
        result,
    )

    return result


def augment_simple_fct_question(
    question: str,
) -> str:
    if not isinstance(
        question,
        str,
    ):
        return question

    if not is_simple_fct_question(
        question
    ):
        return question

    context = search_fct_context(
        question
    )

    if not context:
        # Sem evidência Web:
        # mantém integralmente o pipeline existente.
        return question

    return f"""
[MINERVA_FCT_OFICIAL]

A pergunta abaixo foi classificada como institucional simples.

REGRAS OBRIGATORIAS:
1. Priorize as evidencias oficiais recuperadas de fct.ufpa.br.
2. FCT significa Faculdade de Computacao e Telecomunicacoes da UFPA.
3. Nao confunda a FCT/UFPA com instituicoes externas de mesma sigla.
4. Nao invente nomes, cargos, telefones, datas, prazos ou procedimentos.
5. Responda em portugues do Brasil.
6. Seja direto e didatico.
7. Quando utilizar evidencia Web, informe a fonte oficial.
8. Preserve os demais mecanismos atuais da Minerva.
9. Para RU e cardapio, preserve a rota PROAES existente.
10. Se a evidencia for insuficiente, nao invente informacao.

EVIDENCIAS OFICIAIS FCT/UFPA:
{context}

PERGUNTA ORIGINAL DO USUARIO:
{question}
""".strip()


