CACHE_TTL_SECONDS = 15 * 60

MAX_LINKS_TO_FETCH = 8
MAX_PASSAGES = 8
MAX_CONTEXT_CHARS = 8500


_CACHE: Dict[str, Tuple[float, str]] = {}


