@dataclass(frozen=True)
class Passage:
    score: float
    text: str
    url: str
    title: str


def _normalize(text: str) -> str:
    text = unicodedata.normalize("NFKD", text or "")
    text = "".join(ch for ch in text if not unicodedata.combining(ch))
    text = text.lower()
    text = re.sub(r"[^a-z0-9\s\-_/]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def _tokens(text: str) -> List[str]:
    normalized = _normalize(text)
    return [
        tok
        for tok in re.findall(r"[a-z0-9]{2,}", normalized)
        if tok not in STOPWORDS
    ]


def _is_official_fct_url(url: str) -> bool:
    try:
        host = (urlparse(url).hostname or "").lower()
        return host == FCT_DOMAIN or host.endswith("." + FCT_DOMAIN)
    except Exception:
        return False


def is_simple_fct_question(question: str) -> bool:
    """
    Decide se a pergunta deve consultar primeiro o portal oficial da FCT.

    Conservador:
    - não captura RU/cardápio;
    - não substitui o RAG em questões normativas/complexas;
    - prioriza perguntas curtas e institucionais.
    """
    q = _normalize(question)
    words = q.split()

    if not q:
        return False

    if any(term in q for term in SPECIAL_ROUTE_TERMS):
        return False

    if any(term in q for term in COMPLEX_TERMS):
        return False

    # Pergunta excessivamente longa: mantém pipeline RAG atual.
    if len(words) > 28:
        return False

    # Intenções institucionais claramente simples.
    if any(term in q for term in SIMPLE_INTENT_TERMS):
        return True

    # Minerva é escopada à FCT/UFPA:
    # perguntas muito curtas podem consultar o portal primeiro.
    if len(words) <= 12:
        return True

    return False


def _cache_get(key: str) -> Optional[str]:
    item = _CACHE.get(key)
    if not item:
        return None

    created_at, value = item
    if time.time() - created_at > CACHE_TTL_SECONDS:
        _CACHE.pop(key, None)
        return None

    return value


def _cache_set(key: str, value: str) -> None:
    _CACHE[key] = (time.time(), value)


def _fetch(url: str) -> Optional[str]:
    if not _is_official_fct_url(url):
        return None

    try:
        response = SESSION.get(
            url,
            timeout=REQUEST_TIMEOUT,
            allow_redirects=True,
        )
        response.raise_for_status()

        if not _is_official_fct_url(response.url):
            return None

        content_type = response.headers.get("Content-Type", "")
        if "text/html" not in content_type.lower():
            return None

        response.encoding = response.apparent_encoding or response.encoding
        return response.text

    except requests.RequestException:
        return None


def _soup(html: str) -> BeautifulSoup:
    soup = BeautifulSoup(html, "html.parser")

    for tag in soup(
        [
            "script",
            "style",
            "noscript",
            "svg",
            "form",
            "iframe",
        ]
    ):
        tag.decompose()

    return soup


def _page_title(soup: BeautifulSoup) -> str:
    h1 = soup.find("h1")
    if h1:
        title = h1.get_text(" ", strip=True)
        if title:
            return title[:240]

    if soup.title:
        return soup.title.get_text(" ", strip=True)[:240]

    return "FCT/UFPA"


def _extract_passages(
    html: str,
    url: str,
    question_tokens: Sequence[str],
) -> List[Passage]:
    soup = _soup(html)
    title = _page_title(soup)

    # Prioriza conteúdo principal.
    root = (
        soup.find("main")
        or soup.find("article")
        or soup.select_one(".item-page")
        or soup.select_one("#content")
        or soup.body
        or soup
    )

    candidates: List[str] = []

    for element in root.find_all(
        ["h1", "h2", "h3", "h4", "p", "li", "td"],
        recursive=True,
    ):
        text = re.sub(
            r"\s+",
            " ",
            element.get_text(" ", strip=True),
        ).strip()

        if 30 <= len(text) <= 1800:
            candidates.append(text)

    qset = set(question_tokens)
    passages: List[Passage] = []

    for text in candidates:
        normalized = _normalize(text)
        tset = set(_tokens(text))

        overlap = len(qset & tset)

        if qset:
            coverage = overlap / max(1, len(qset))
        else:
            coverage = 0.0

        score = (
            overlap * 5.0
            + coverage * 10.0
        )

        # Bônus por frase/termo relevante.
        for token in qset:
            if token in normalized:
                score += 0.8

        # Títulos e textos institucionais têm utilidade adicional.
        if any(
            marker in normalized
            for marker in (
                "faculdade",
                "graduacao",
                "engenharia",
                "coordenacao",
                "secretaria",
                "docente",
                "disciplina",
                "estagio",
                "laboratorio",
                "documentacao",
            )
        ):
            score += 0.6

        if score > 0:
            passages.append(
                Passage(
                    score=score,
                    text=text,
                    url=url,
                    title=title,
                )
            )

    return passages


def _discover_links(
    html: str,
    source_url: str,
    question_tokens: Sequence[str],
) -> List[Tuple[float, str]]:
    soup = _soup(html)
    qset = set(question_tokens)

    found: Dict[str, float] = {}

    for a in soup.find_all("a", href=True):
        href = (a.get("href") or "").strip()

        if not href:
            continue

        absolute = urljoin(source_url, href)
        absolute = absolute.split("#", 1)[0]

        if not _is_official_fct_url(absolute):
            continue

        anchor = a.get_text(" ", strip=True)
        material = _normalize(anchor + " " + absolute)
        link_tokens = set(_tokens(material))

        overlap = len(qset & link_tokens)
        score = overlap * 6.0

        # URLs de conteúdo costumam ser mais úteis.
        if "/index.php/" in absolute:
            score += 1.0

        # Bônus para áreas institucionais da FCT.
        if any(
            term in material
            for term in (
                "graduacao",
                "computacao",
                "telecomunicacoes",
                "docente",
                "documentacao",
                "disciplina",
                "estagio",
                "laboratorio",
                "secretaria",
                "historico",
                "faculdade",
                "noticia",
                "concurso",
                "intercambio",
            )
        ):
            score += 2.0

        previous = found.get(absolute)
        if previous is None or score > previous:
            found[absolute] = score

    return sorted(
        ((score, url) for url, score in found.items()),
        key=lambda item: item[0],
        reverse=True,
    )


def search_fct_context(question: str) -> str:
    """
    Busca evidência apenas em fct.ufpa.br.
    Retorna contexto rastreável para o pipeline atual da Minerva.
    """
    cache_key = hashlib.sha256(
        _normalize(question).encode("utf-8")
    ).hexdigest()

    cached = _cache_get(cache_key)
    if cached is not None:
        return cached

    question_tokens = _tokens(question)

    search_url = (
        FCT_BASE_URL
        + "index.php/component/search/"
        + "?searchword="
        + quote_plus(question)
        + "&searchphrase=all"
    )

    seed_urls = [
        search_url,
        FCT_BASE_URL,
    ]

    html_by_url: Dict[str, str] = {}
    discovered: Dict[str, float] = {}

    for seed_url in seed_urls:
        html = _fetch(seed_url)

        if not html:
            continue

        html_by_url[seed_url] = html

        for score, link in _discover_links(
            html,
            seed_url,
            question_tokens,
        ):
            discovered[link] = max(
                score,
                discovered.get(link, float("-inf")),
            )

    # Adiciona páginas mais relevantes descobertas no próprio portal.
    ranked_links = sorted(
        discovered.items(),
        key=lambda item: item[1],
        reverse=True,
    )[:MAX_LINKS_TO_FETCH]

    for url, _score in ranked_links:
        if url in html_by_url:
            continue

        html = _fetch(url)
        if html:
            html_by_url[url] = html

    all_passages: List[Passage] = []

    for url, html in html_by_url.items():
        all_passages.extend(
            _extract_passages(
                html,
                url,
                question_tokens,
            )
        )

    # Remove duplicidades.
    unique: Dict[str, Passage] = {}

    for passage in all_passages:
        fingerprint = _normalize(passage.text)[:700]

        current = unique.get(fingerprint)
        if current is None or passage.score > current.score:
            unique[fingerprint] = passage

    ranked = sorted(
        unique.values(),
        key=lambda p: p.score,
        reverse=True,
    )[:MAX_PASSAGES]

    if not ranked:
        _cache_set(cache_key, "")
        return ""

    blocks: List[str] = []
    total_chars = 0

    for index, passage in enumerate(ranked, start=1):
        block = (
            f"[EVIDÊNCIA FCT {index}]\n"
            f"Título: {passage.title}\n"
            f"Trecho: {passage.text}\n"
            f"Fonte: {passage.url}\n"
        )

        if total_chars + len(block) > MAX_CONTEXT_CHARS:
            break

        blocks.append(block)
        total_chars += len(block)

    result = "\n".join(blocks).strip()
    _cache_set(cache_key, result)

    return result


def augment_simple_fct_question(question: str) -> str:
    """
    Para pergunta simples:
      1. consulta FCT;
      2. anexa evidências oficiais;
      3. deixa o pipeline atual da Minerva gerar a resposta.

    Para pergunta complexa:
      preserva integralmente o comportamento existente.
    """
    if not isinstance(question, str):
        return question

    if not is_simple_fct_question(question):
        return question

    context = search_fct_context(question)

    if not context:
        return question

    return f"""
[ROTEAMENTO_INTERNO_MINERVA_FCT_WEB]

A pergunta abaixo foi classificada como uma pergunta institucional simples.

REGRAS OBRIGATÓRIAS:
1. Priorize as evidências oficiais obtidas no portal fct.ufpa.br.
2. A sigla FCT, neste contexto, refere-se à unidade da UFPA.
3. Não confunda com instituições externas de mesma sigla.
4. Não invente nomes, cargos, telefones, datas, prazos ou procedimentos.
5. Responda em português do Brasil.
6. Seja direto e didático.
7. Quando usar uma evidência Web, apresente a fonte oficial ao final.
8. Se as evidências não responderem à pergunta, preserve os demais mecanismos atuais da Minerva.
9. Não trate conteúdo externo à UFPA como resposta institucional.
10. Não diga que pesquisou algo que não aparece nas evidências.

EVIDÊNCIAS OFICIAIS RECUPERADAS:
{context}

PERGUNTA ORIGINAL DO USUÁRIO:
{question}

Produza a resposta final ao usuário.
""".strip()


