            "o modelo de TCC",
            FCT_BASE + "/",
        )

    text = _joined_normalized(
        parser
    )

    if (
        "modelo em latex para tcc"
        in text
        or "overleaf" in text
    ):
        return (
            f"O portal oficial da FCT disponibiliza, na área de Serviços, "
            f"um modelo em LaTeX para TCC no Overleaf. "
            f"Acesse o portal da FCT e procure por "
            f"“Modelo em Latex para TCC no Overleaf”. "
            f"{_source_line(FCT_BASE + '/')}"
        )

    return _temporary_failure(
        "o modelo de TCC",
        FCT_BASE + "/",
