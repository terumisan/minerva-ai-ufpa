def _is_fct_url(url: str) -> bool:
    try:
        parsed = urlparse(url)

        host = (
            parsed.hostname
            or ""
        ).lower().strip(".")

        scheme = (
            parsed.scheme
            or ""
        ).lower()

        return (
            scheme in {
                "http",
                "https",
            }
            and (
                host == "fct.ufpa.br"
                or host.endswith(
                    ".fct.ufpa.br"
                )
            )
        )

    except Exception:
        return False


# ======================================================================
# CLASSIFICAÇÃO DETERMINÍSTICA
#
# REGRA FUNDAMENTAL:
# "FCT" sozinho NÃO define intenção.
#
# Assim:
#   "Quais cursos a FCT oferece?"
# não cai em "fct_identity".
# ======================================================================


def detect_direct_intent(
    question: str,
) -> Optional[str]:
    if not isinstance(
        question,
        str,
    ):
        return None

    q = _normalize(
        question
    )

    if not q:
        return None

    q_tokens = _tokens(
        q
    )

    # ----------------------------------------------------------
    # 0. RU/PROAES
    # Preserva integralmente a rota já existente.
    # ----------------------------------------------------------

    if (
        "ru" in q_tokens
        or "cardapio" in q_tokens
        or "bandejao" in q_tokens
        or "proaes" in q_tokens
        or "restaurante universitario" in q
    ):
        return None


    # ----------------------------------------------------------
    # 1. PROFESSORES
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "professor",
            "professores",
            "docente",
            "docentes",
            "corpo docente",
            "quem da aula",
            "quem ensina",
            "titulacao do professor",
        )
    ):
        return "faculty"


    # ----------------------------------------------------------
    # 2. DIREÇÃO
    # Deve vir ANTES da identidade FCT.
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "diretor",
            "diretora",
            "vice diretor",
            "vice-diretor",
            "vice diretora",
            "vice-diretora",
            "direcao",
            "quem dirige",
            "responsavel pela faculdade",
        )
    ):
        return "leadership"


    # ----------------------------------------------------------
    # 3. CURSOS
    # Deve vir ANTES da identidade FCT.
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "quais cursos",
            "qual curso",
            "cursos a fct",
            "cursos da fct",
            "curso oferece",
            "cursos oferece",
            "graduacoes",
            "graduacao oferece",
            "engenharia da computacao",
            "engenharia de telecomunicacoes",
            "engenharias existem",
        )
    ):
        return "courses"


    # ----------------------------------------------------------
    # 4. CONTATO
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "telefone",
            "contato",
            "e mail",
            "email",
            "secretaria",
            "endereco",
            "localizacao",
            "onde fica a fct",
            "como falar com",
        )
    ):
        return "contact"


    # ----------------------------------------------------------
    # 5. TCC
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "modelo de tcc",
            "template de tcc",
            "overleaf",
            "tcc em latex",
            "modelo latex",
        )
    ):
        return "tcc_template"


    # ----------------------------------------------------------
    # 6. DOCUMENTAÇÃO
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "onde encontro documentos",
            "onde encontro formularios",
            "documentacao da fct",
            "documentos da fct",
            "formularios da fct",
        )
    ):
        return "documentation"


    # ----------------------------------------------------------
    # 7. ESTÁGIO
    # Apenas perguntas simples de localização.
    # Questões normativas continuam no RAG.
    # ----------------------------------------------------------

    if (
        "estagio" in q
        and any(
            marker in q
            for marker in (
                "onde encontro",
                "onde consultar",
                "tem pagina",
                "informacoes sobre",
            )
        )
    ):
        return "internship_source"


    # ----------------------------------------------------------
    # 8. HISTÓRICO
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "historia da fct",
            "historico da fct",
            "como surgiu a fct",
            "origem da fct",
        )
    ):
        return "history_source"


    # ----------------------------------------------------------
    # 9. IDENTIDADE
    #
    # IMPORTANTE:
    # não usar simplesmente:
    #     if "fct" in q
    #
    # Esse era o comportamento que fazia todas as respostas
    # virarem a definição genérica.
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "o que significa fct",
            "fct significa o que",
            "fct significa",
            "o que e a fct",
            "o que e fct",
            "nome completo da fct",
            "qual e o nome da fct",
            "que faculdade e a fct",
        )
    ):
        return "identity"

    return None


