def direct_official_answer(
    question: str,
) -> Optional[str]:
    """
    Retorna:
      - str  -> resposta institucional direta
      - None -> deixa o pipeline/RAG atual continuar

    Não modifica a pergunta original.
    """

    if not isinstance(
        question,
        str,
    ):
        return None

    if not question.strip():
        return None

    intent = detect_direct_intent(
        question
    )

    if intent is None:
        return None


    cache_key = (
        intent
        + "::"
        + _normalize(question)
    )

    cached = _ANSWER_CACHE.get(
        cache_key
    )

    if cached is not None:
        created_at, answer = cached

        if (
            time.time() - created_at
            <= CACHE_TTL
        ):
            return answer


    answer: Optional[str]


    if intent == "identity":
        answer = _answer_identity()

    elif intent == "courses":
        answer = _answer_courses()

    elif intent == "leadership":
        answer = _answer_leadership(
            question
        )

    elif intent == "faculty":
        answer = _answer_faculty(
            question
        )

    elif intent == "contact":
        answer = _answer_contact(
            question
        )

    elif intent == "tcc_template":
        answer = _answer_tcc_template()

    elif intent == "documentation":
        answer = _answer_documentation()

    elif intent == "internship_source":
        answer = _answer_internship_source()

    elif intent == "history_source":
        answer = _answer_history_source()

    else:
        answer = None


    _ANSWER_CACHE[
        cache_key
    ] = (
        time.time(),
        answer,
    )

    return answer


