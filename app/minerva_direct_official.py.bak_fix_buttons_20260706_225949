def _answer_identity() -> str:
    parser = _load_page(
        URL_ABOUT
    )

    if parser is None:
        return _temporary_failure(
            "a identidade institucional da faculdade",
            URL_ABOUT,
        )

    text = _joined_normalized(
        parser
    )

    official_name = (
        "Faculdade de Engenharia da Computação e Telecomunicações"
    )

    if (
        "faculdade de engenharia da computacao e telecomunicacoes"
        not in text
    ):
        return _temporary_failure(
            "a identidade institucional da faculdade",
            URL_ABOUT,
        )

    return (
        f"A FCT é a {official_name}, unidade da "
        f"Universidade Federal do Pará (UFPA). "
        f"A faculdade desenvolve atividades de ensino, pesquisa e extensão. "
        f"{_source_line(URL_ABOUT)}"
    )


def _answer_courses() -> str:
    parser = _load_page(
        URL_ABOUT
    )

    if parser is None:
        return _temporary_failure(
            "os cursos oferecidos",
            URL_ABOUT,
        )

    text = _joined_normalized(
        parser
    )

    courses: List[str] = []

    if (
        "engenharia da computacao"
        in text
    ):
        courses.append(
            "Engenharia da Computação"
        )

    if (
        "engenharia de telecomunicacoes"
        in text
    ):
        courses.append(
            "Engenharia de Telecomunicações"
        )

    if not courses:
        return _temporary_failure(
            "os cursos oferecidos",
            URL_ABOUT,
        )

    if len(courses) == 2:
        course_text = (
            f"{courses[0]} e {courses[1]}"
        )
    else:
        course_text = ", ".join(
            courses
        )

    return (
        f"A FCT/UFPA oferece, no campus Belém, "
        f"os cursos de {course_text}. "
        f"Segundo o portal institucional, ambos integram a área de tecnologia, "
        f"mas possuem formações específicas em computação e telecomunicações. "
        f"{_source_line(URL_ABOUT)}"
    )


def _answer_leadership(
    question: str,
) -> str:
    parser = _load_page(
        URL_CONTACT
    )

    if parser is None:
        # Segunda tentativa em página institucional.
        parser = _load_page(
            URL_ABOUT
        )

    if parser is None:
        return _temporary_failure(
            "a direção da faculdade",
            URL_CONTACT,
        )

    director = _label_value(
        parser.pieces,
        (
            "Diretor",
        ),
    )

    vice = _label_value(
        parser.pieces,
        (
            "Vice-Diretor",
            "Vice-diretor",
            "Vice Diretor",
            "Vice diretor",
        ),
    )

    q = _normalize(
        question
    )

    asks_vice = (
        "vice diretor" in q
        or "vice-diretor" in q
        or "vice diretora" in q
        or "vice-diretora" in q
    )

    if asks_vice:
        if not vice:
            return _temporary_failure(
                "a vice-direção da faculdade",
                URL_CONTACT,
            )

        return (
            f"O vice-diretor da FCT/UFPA é {vice}. "
            f"{_source_line(URL_CONTACT)}"
        )

    if not director:
        return _temporary_failure(
            "a direção da faculdade",
            URL_CONTACT,
        )

    # Pergunta ampla sobre direção.
    if (
        "quem compoe" in q
        or "direcao da fct" in q
        or "quem esta na direcao" in q
    ):
        if vice:
            return (
                f"A direção da FCT/UFPA é composta pelo diretor "
                f"{director} e pelo vice-diretor {vice}. "
                f"{_source_line(URL_CONTACT)}"
            )

    return (
        f"O diretor da FCT/UFPA é {director}. "
        f"{_source_line(URL_CONTACT)}"
    )


def _answer_faculty(
    question: str,
) -> str:
    parser = _load_page(
        URL_FACULTY
    )

    if parser is None:
        return _temporary_failure(
            "o corpo docente",
            URL_FACULTY,
        )

    faculty = _extract_faculty(
        parser
    )

    if not faculty:
        return _temporary_failure(
            "o corpo docente",
            URL_FACULTY,
        )

    q = _normalize(
        question
    )

    # ----------------------------------------------------------
    # Contagem
    # ----------------------------------------------------------

    if any(
        marker in q
        for marker in (
            "quantos professores",
            "quantos docentes",
        )
    ):
        return (
            f"A página oficial de Corpo Docente da FCT apresenta "
            f"{len(faculty)} docentes. "
            f"{_source_line(URL_FACULTY)}"
        )


    # ----------------------------------------------------------
    # Doutores
    # ----------------------------------------------------------

    if (
        "doutor" in q
        or "doutores" in q
    ):
        selected = [
            name
            for name, degree in faculty
            if _normalize(degree) in {
                "doutor",
                "doutora",
            }
        ]

        if selected:
            return (
                f"Segundo a página oficial da FCT, os docentes com "
                f"titulação indicada como doutor ou doutora são: "
                f"{'; '.join(selected)}. "
                f"{_source_line(URL_FACULTY)}"
            )


    # ----------------------------------------------------------
    # Mestres
    # ----------------------------------------------------------

    if (
        "mestre" in q
        or "mestres" in q
    ):
        selected = [
            name
            for name, degree in faculty
            if _normalize(degree) in {
                "mestre",
                "mestra",
            }
        ]

        if selected:
            return (
                f"Segundo a página oficial da FCT, os docentes com "
                f"titulação indicada como mestre ou mestra são: "
                f"{'; '.join(selected)}. "
                f"{_source_line(URL_FACULTY)}"
            )


    # ----------------------------------------------------------
    # Lista geral
    # ----------------------------------------------------------

    formatted = [
        f"{name} ({degree})"
        for name, degree in faculty
    ]

    return (
        f"Segundo a página oficial de Corpo Docente da FCT/UFPA, "
        f"os docentes listados são: "
        f"{'; '.join(formatted)}. "
        f"{_source_line(URL_FACULTY)}"
    )


def _answer_contact(
    question: str,
) -> str:
    parser = _load_page(
        URL_CONTACT
    )

    if parser is None:
        return _temporary_failure(
            "os dados de contato",
            URL_CONTACT,
        )

    phone = _label_value(
        parser.pieces,
        (
            "Telefone",
        ),
    )

    email = _label_value(
        parser.pieces,
        (
            "E-mail",
            "Email",
        ),
    )

    secretary = _label_value(
        parser.pieces,
        (
            "Secretaria",
            "Secretário",
            "Secretaria",
        ),
    )

    q = _normalize(
        question
    )


    if "telefone" in q:
        if not phone:
            return _temporary_failure(
                "o telefone",
                URL_CONTACT,
            )

        return (
            f"O telefone informado pela FCT/UFPA é {phone}. "
            f"{_source_line(URL_CONTACT)}"
        )


    if (
        "email" in q
        or "e mail" in q
    ):
        if not email:
            return _temporary_failure(
                "o e-mail",
                URL_CONTACT,
            )

        return (
            f"O e-mail institucional informado na página de contato "
            f"da FCT/UFPA é {email}. "
            f"{_source_line(URL_CONTACT)}"
        )


    if (
        "secretaria" in q
        or "secretario" in q
    ):
        parts: List[str] = []

        if secretary:
            parts.append(
                f"A secretaria é identificada no portal como {secretary}"
            )

        if email:
            parts.append(
                f"o e-mail informado é {email}"
            )

        if phone:
            parts.append(
                f"o telefone é {phone}"
            )

        if parts:
            return (
                ". ".join(parts)
                + ". "
                + _source_line(
                    URL_CONTACT
                )
            )


    # Resposta ampla de contato.
    values: List[str] = []

    if email:
        values.append(
            f"e-mail {email}"
        )

    if phone:
        values.append(
            f"telefone {phone}"
        )

    if values:
        return (
            f"Os dados de contato localizados no portal oficial da "
            f"FCT/UFPA incluem {', '.join(values)}. "
            f"{_source_line(URL_CONTACT)}"
        )

    return _temporary_failure(
        "os dados de contato",
        URL_CONTACT,
    )


