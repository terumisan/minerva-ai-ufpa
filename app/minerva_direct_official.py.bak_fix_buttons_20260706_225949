# ======================================================================
# NORMALIZAÇÃO
# ======================================================================


def _normalize(text: str) -> str:
    text = unicodedata.normalize(
        "NFKD",
        text or "",
    )

    text = "".join(
        ch
        for ch in text
        if not unicodedata.combining(ch)
    )

    text = text.lower()

    text = re.sub(
        r"[^a-z0-9\s\-_/]",
        " ",
        text,
    )

    return re.sub(
        r"\s+",
        " ",
        text,
    ).strip()


def _tokens(text: str) -> set[str]:
    return set(
        re.findall(
            r"[a-z0-9]{2,}",
            _normalize(text),
        )
    )


