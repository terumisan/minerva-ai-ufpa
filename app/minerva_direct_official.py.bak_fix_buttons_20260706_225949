def _joined_text(
    parser: _PortalParser,
) -> str:
    return "\n".join(
        parser.pieces
    )


def _joined_normalized(
    parser: _PortalParser,
) -> str:
    return _normalize(
        " ".join(
            parser.pieces
        )
    )


def _clean_value(
    value: str,
) -> str:
    return re.sub(
        r"\s+",
        " ",
        value or "",
    ).strip(
        " \t\r\n:;|"
    )


def _label_value(
    pieces: Sequence[str],
    labels: Sequence[str],
) -> Optional[str]:
    """
    Busca valores como:
      Diretor: Prof. Dr. ...
      Telefone: (91) ...
      E-mail: ...
    """

    normalized_labels = [
        _normalize(label)
        for label in labels
    ]

    stop_labels = (
        "diretor",
        "vice diretor",
        "coordenador",
        "coordenadora",
        "secretaria",
        "secretario",
        "secretaria",
        "e mail",
        "email",
        "telefone",
        "localizacao",
    )

    for index, piece in enumerate(
        pieces
    ):
        normalized_piece = _normalize(
            piece
        )

        for original_label, normalized_label in zip(
            labels,
            normalized_labels,
        ):
            # Exemplo:
            # "Diretor: Prof. Dr. Ilan..."
            pattern = re.compile(
                rf"(?i)"
                rf"^\s*"
                rf"{re.escape(original_label)}"
                rf"\s*:\s*"
                rf"(.+?)"
                rf"\s*$"
            )

            match = pattern.match(
                piece
            )

            if match:
                value = _clean_value(
                    match.group(1)
                )

                if value:
                    return value


            # Exemplo:
            # piece atual = "Diretor:"
            # próxima piece = "Prof. Dr. ..."
            if normalized_piece in {
                normalized_label,
                normalized_label + " ",
            } or normalized_piece.rstrip(":") == normalized_label:

                for next_index in range(
                    index + 1,
                    min(
                        len(pieces),
                        index + 4,
                    ),
                ):
                    candidate = _clean_value(
                        pieces[next_index]
                    )

                    candidate_norm = _normalize(
                        candidate
                    )

                    if not candidate:
                        continue

                    if any(
                        candidate_norm.startswith(
                            stop
                        )
                        for stop in stop_labels
                    ):
                        break

                    return candidate

    return None


def _extract_faculty(
    parser: _PortalParser,
) -> List[
    Tuple[str, str]
]:
    """
    Extrai entradas como:
      ADALBERY RODRIGUES CASTRO (DOUTOR)
      EURIPEDES ... (MESTRE)
    """

    found: List[
        Tuple[str, str]
    ] = []

    seen = set()

    pattern = re.compile(
        r"^\s*"
        r"([A-ZÀ-ÖØ-Ý]"
        r"[A-ZÀ-ÖØ-Ý0-9 .'\-]{3,150})"
        r"\s*"
        r"\("
        r"(DOUTOR|DOUTORA|MESTRE|MESTRA)"
        r"\)"
        r"\s*$"
    )

    for piece in parser.pieces:
        match = pattern.match(
            piece
        )

        if not match:
            continue

        name = _clean_value(
            match.group(1)
        )

        degree = _clean_value(
            match.group(2)
        )

        key = _normalize(
            name
        )

        if not key or key in seen:
            continue

        seen.add(
            key
        )

        found.append(
            (
                name.title(),
                degree.title(),
            )
        )

    return found


def _source_line(
    url: str,
) -> str:
    return (
        f"Fonte oficial: {url}"
    )


def _temporary_failure(
    subject: str,
    url: str,
