from __future__ import annotations

import re
import time
import unicodedata
from html.parser import HTMLParser
from typing import Dict, List, Optional, Tuple
from urllib.parse import urlparse
from urllib.request import Request, urlopen
from urllib.error import HTTPError, URLError


FCT = "https://fct.ufpa.br"
URL_SOBRE = f"{FCT}/index.php/sobre-a-faculdade"
URL_CONTATO = f"{FCT}/index.php/contato"
URL_DOCENTES = f"{FCT}/index.php/corpo-docente"
URL_DOCS = f"{FCT}/index.php/documentacao"
URL_ESTAGIO = f"{FCT}/index.php/estagio"
URL_DISCIPLINAS = f"{FCT}/index.php/plano-da-disciplina"

CACHE: Dict[str, Tuple[float, str]] = {}
TTL = 900


def norm(txt: str) -> str:
    txt = unicodedata.normalize("NFKD", txt or "")
    txt = "".join(c for c in txt if not unicodedata.combining(c))
    txt = txt.lower()
    txt = re.sub(r"[^a-z0-9\s]", " ", txt)
    return re.sub(r"\s+", " ", txt).strip()


class Parser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.skip = 0
        self.texts: List[str] = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() in {"script", "style", "svg", "iframe", "noscript"}:
            self.skip += 1

    def handle_endtag(self, tag):
        if tag.lower() in {"script", "style", "svg", "iframe", "noscript"} and self.skip:
            self.skip -= 1

    def handle_data(self, data):
        if self.skip:
            return
        text = re.sub(r"\s+", " ", data).strip()
        if text:
            self.texts.append(text)


def is_fct(url: str) -> bool:
    try:
        host = urlparse(url).hostname or ""
        return host == "fct.ufpa.br" or host.endswith(".fct.ufpa.br")
    except Exception:
        return False


def fetch(url: str) -> str:
    if not is_fct(url):
        return ""

    item = CACHE.get(url)
    if item and time.time() - item[0] < TTL:
        return item[1]

    try:
        req = Request(url, headers={"User-Agent": "MinervaAI-FCT/5.0"})
        with urlopen(req, timeout=10) as resp:
            raw = resp.read()
            enc = resp.headers.get_content_charset() or "utf-8"
            html = raw.decode(enc, errors="replace")
            CACHE[url] = (time.time(), html)
            return html
    except (HTTPError, URLError, TimeoutError, OSError):
        return ""


def page_text(url: str) -> str:
    html = fetch(url)
    if not html:
        return ""
    p = Parser()
    try:
        p.feed(html)
        p.close()
    except Exception:
        pass
    return "\n".join(p.texts)


def label_value(text: str, labels: List[str]) -> Optional[str]:
    lines = [x.strip() for x in text.splitlines() if x.strip()]
    for i, line in enumerate(lines):
        for label in labels:
            m = re.match(rf"^{re.escape(label)}\s*:\s*(.+)$", line, flags=re.I)
            if m:
                return m.group(1).strip()
            if norm(line).rstrip(":") == norm(label) and i + 1 < len(lines):
                return lines[i + 1].strip()
    return None


def faculty_list(text: str) -> List[str]:
    out = []
    seen = set()
    pat = re.compile(r"^([A-ZÀ-ÖØ-Ý][A-ZÀ-ÖØ-Ý0-9 .'\-]{3,150})\s*\((DOUTOR|DOUTORA|MESTRE|MESTRA)\)$")
    for line in text.splitlines():
        m = pat.match(line.strip())
        if not m:
            continue
        name = re.sub(r"\s+", " ", m.group(1)).strip().title()
        degree = m.group(2).title()
        key = norm(name)
        if key not in seen:
            seen.add(key)
            out.append(f"{name} ({degree})")
    return out


def intent(question: str) -> Optional[str]:
    q = norm(question)

    if any(x in q for x in ["cardapio", "restaurante universitario", "bandejao"]) or " ru " in f" {q} ":
        return None

    if any(x in q for x in ["diretor", "diretora", "vice diretor", "vice diretora", "direcao"]):
        return "diretor"

    if any(x in q for x in ["professor", "professores", "docente", "docentes", "corpo docente"]):
        return "docentes"

    if any(x in q for x in ["quais cursos", "curso a fct", "cursos a fct", "cursos oferece", "engenharia da computacao", "engenharia de telecomunicacoes"]):
        return "cursos"

    if any(x in q for x in ["telefone", "email", "e mail", "contato", "secretaria", "endereco", "localizacao", "onde fica"]):
        return "contato"

    if any(x in q for x in ["regulamento do tcc", "regras do tcc", "normas do tcc", "como funciona o tcc", "tcc", "trabalho de conclusao"]):
        return "tcc"

    if any(x in q for x in ["estagio", "regras de estagio", "regulamento de estagio"]):
        return "estagio"

    if any(x in q for x in ["matricula", "matricular", "sigaa", "calouro"]):
        return "matricula"

    if any(x in q for x in ["documento", "documentacao", "formulario", "formularios", "requerimento"]):
        return "documentacao"

    if any(x in q for x in ["o que significa fct", "fct significa", "o que e a fct", "nome completo da fct"]):
        return "identidade"

    return None


def direct_official_answer(question: str) -> Optional[str]:
    it = intent(question)
    if it is None:
        return None

    if it == "identidade":
        return (
            "A FCT é a Faculdade de Engenharia da Computação e Telecomunicações, "
            "unidade da Universidade Federal do Pará (UFPA). "
            f"Fonte oficial: {URL_SOBRE}"
        )

    if it == "cursos":
        txt = norm(page_text(URL_SOBRE))
        cursos = []
        if "engenharia da computacao" in txt:
            cursos.append("Engenharia da Computação")
        if "engenharia de telecomunicacoes" in txt:
            cursos.append("Engenharia de Telecomunicações")
        if cursos:
            return f"A FCT/UFPA oferece os cursos de {', '.join(cursos)}. Fonte oficial: {URL_SOBRE}"
        return f"A FCT/UFPA possui informações sobre seus cursos na página institucional. Fonte oficial: {URL_SOBRE}"

    if it == "diretor":
        txt = page_text(URL_CONTATO) or page_text(URL_SOBRE)
        diretor = label_value(txt, ["Diretor"])
        vice = label_value(txt, ["Vice-Diretor", "Vice Diretor", "Vice-diretor"])
        if diretor and "vice" not in norm(question):
            return f"O diretor da FCT/UFPA é {diretor}. Fonte oficial: {URL_CONTATO}"
        if vice:
            return f"O vice-diretor da FCT/UFPA é {vice}. Fonte oficial: {URL_CONTATO}"
        return f"A informação sobre direção deve ser consultada na página oficial de contato da FCT. Fonte oficial: {URL_CONTATO}"

    if it == "docentes":
        txt = page_text(URL_DOCENTES)
        docentes = faculty_list(txt)
        if docentes:
            return "Segundo a página oficial de Corpo Docente da FCT/UFPA, os docentes listados são: " + "; ".join(docentes) + f". Fonte oficial: {URL_DOCENTES}"
        return f"A lista oficial de docentes deve ser consultada na página Corpo Docente da FCT. Fonte oficial: {URL_DOCENTES}"

    if it == "contato":
        txt = page_text(URL_CONTATO)
        email = label_value(txt, ["E-mail", "Email"])
        telefone = label_value(txt, ["Telefone"])
        partes = []
        if email:
            partes.append(f"e-mail: {email}")
        if telefone:
            partes.append(f"telefone: {telefone}")
        if partes:
            return "Contato oficial da FCT/UFPA: " + "; ".join(partes) + f". Fonte oficial: {URL_CONTATO}"
        return f"Os dados oficiais de contato da FCT estão disponíveis na página de contato. Fonte oficial: {URL_CONTATO}"

    if it == "tcc":
        return (
            "Para regulamento, modelo ou orientações de TCC, a Minerva deve consultar primeiro a seção de Documentação da FCT "
            "e, quando necessário, complementar com os documentos institucionais indexados na base RAG. "
            f"Fonte oficial inicial: {URL_DOCS}"
        )

    if it == "estagio":
        return (
            "As informações sobre estágio devem ser verificadas primeiro na página oficial de estágio da FCT. "
            "Para regras específicas, documentos e procedimentos, a resposta deve ser complementada com a documentação institucional da base da Minerva. "
            f"Fonte oficial: {URL_ESTAGIO}"
        )

    if it == "matricula":
        return (
            "Para matrícula, ajuste de matrícula e acesso ao SIGAA, a orientação deve considerar primeiro as informações da FCT "
            "e depois os portais acadêmicos oficiais da UFPA, como PROEG e SIGAA. "
            f"Fonte inicial da FCT: {FCT}/"
        )

    if it == "documentacao":
        return (
            "A FCT possui uma seção oficial de Documentação. Formulários, requerimentos, normas e documentos acadêmicos devem ser verificados primeiro nela. "
            f"Fonte oficial: {URL_DOCS}"
        )

    return None


def debug_direct_route(question: str) -> dict:
    return {"question": question, "intent": intent(question)}


__all__ = ["direct_official_answer", "debug_direct_route", "intent"]
